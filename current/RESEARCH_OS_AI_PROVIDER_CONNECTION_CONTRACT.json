{
  "contract_id":"research-os-ai-provider-connection-v1",
  "version":1,
  "status":"ACTIVE",
  "purpose":"Canonical provider connection boundary for OpenAI/GPT and Gemini with connector-first readiness and API fallback behind the Research OS API.",
  "authority":{"may_execute":false,"may_authorize":false,"may_approve":false,"may_merge":false,"may_release":false,"release_authority":"FINAL_GATE"},
  "providers":[
    {"id":"openai","label":"OpenAI / GPT","adapter":"openai-compatible","credential_env":["RESEARCH_OS_OPENAI_API_KEY"],"endpoint_env":"RESEARCH_OS_OPENAI_ENDPOINT","model_env":"RESEARCH_OS_OPENAI_MODEL","default_model":"gpt-5.6"},
    {"id":"gemini","label":"Google Gemini","adapter":"gemini","credential_env":["RESEARCH_OS_GEMINI_API_KEY","GEMINI_API_KEY"],"endpoint_env":"RESEARCH_OS_GEMINI_ENDPOINT","model_env":"RESEARCH_OS_GEMINI_MODEL","default_model":"gemini-2.5-flash"}
  ],
  "states":["NOT_CONNECTED","CONNECTING","CONNECTED","DEGRADED","API_FALLBACK","UNAVAILABLE","HOLD"],
  "operations":["STATUS","CONNECT","DISCONNECT","HEALTH_CHECK"],
  "routing":{"primary":"PLATFORM_CONNECTOR","secondary":"PLATFORM_API_FALLBACK","flutter_direct_provider_calls":false},
  "credential_boundary":{"client_receives_secret":false,"server_side_secret_only":true,"evidence_stores_secret":false},
  "ai_authority":{"can_analyze":true,"can_plan":true,"can_generate":true,"can_request_tool_call":true,"can_merge":false,"can_release":false,"can_authorize":false,"can_override_owner":false,"can_bypass_queue_runner":false},
  "fail_closed":{"unknown":"HOLD","credential_missing":"UNAVAILABLE","provider_error":"API_FALLBACK","policy_denied":"HOLD"},
  "evidence":{"required":true,"fields":["provider","operation","state","source_sha","timestamp","result_hash"],"secrets_excluded":true}
}