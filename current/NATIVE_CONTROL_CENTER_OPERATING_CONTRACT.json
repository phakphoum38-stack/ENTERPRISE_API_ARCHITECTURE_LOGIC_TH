  "engines": [
    "CONTROL",
    "EXPERIENCE",
    "KNOWLEDGE",
    "ASSURANCE"
  ],
  "lifecycle": [
    "INTENT",
    "VALIDATE",
    "AUTHORIZE",
    "EXECUTE",
    "OBSERVE",
    "EVIDENCE",
    "COMPLETE",
    "RECOVER"
  ],
  "interaction_modes": [
    "LIVE",
    "SIMULATION",
    "DRY_RUN",
    "REPLAY"
  ],
  "capabilities": [
    "COMMAND_CENTER",
    "UNIVERSAL_SEARCH",
    "UNIVERSAL_INSPECTOR",
    "ACTIVITY_STREAM",
    "SYSTEM_MAP",
    "STATE_VIEWER",
    "EVIDENCE_EXPLORER",
    "FAILURE_CENTER",
    "RESOURCE_VIEWER",
    "HUMAN_CONTROL_BOUNDARY"
