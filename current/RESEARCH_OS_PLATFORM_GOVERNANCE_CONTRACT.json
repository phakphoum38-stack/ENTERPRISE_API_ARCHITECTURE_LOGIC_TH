{
  "contract_id": "research-os-platform-governance-v1",
  "version": 1,
  "status": "ACTIVE",
  "purpose": "Govern the growing Research OS platform by composing existing registries, contracts, dependency graph, architecture invariants, evidence lineage, and Final Gate without creating a second control plane.",
  "canonical_sources": {
    "virtual_workspace_contract": "current/PLATFORM_VIRTUAL_WORKSPACE_CONTRACT.json",
    "virtual_workspace_registry": "current/PLATFORM_VIRTUAL_WORKSPACE_REGISTRY.json",
    "architecture_invariants": "current/ARCHITECTURE_INVARIANTS.md",
    "platform_graph": "tools/platform_graph.py",
    "product_surface_contract": "current/RESEARCH_OS_PRODUCT_SURFACE_INVENTORY_CONTRACT.json",
    "navigation_registry": "apps/research_os_flutter/lib/src/ui/enterprise_navigation.dart",
    "unified_final_gate": "current/RESEARCH_OS_UNIFIED_FINAL_GATE.yml",
    "final_gate_validator": "tools/validate_research_os_unified_final_gate.py"
  },
  "authority": {
    "governance_mode": "DESCRIPTIVE_AND_VALIDATING",
    "may_execute": false,
    "may_authorize": false,
    "may_approve": false,
    "may_merge": false,
    "may_release": false,
    "release_authority": "FINAL_GATE",
    "must_not_create_duplicate_authority": true
  },
  "authority_domains": [
    {"domain":"navigation","canonical":"apps/research_os_flutter/lib/src/ui/enterprise_navigation.dart","role":"CANONICAL_REGISTRY"},
    {"domain":"project_identity","canonical":"tools/project_registry.py","role":"CANONICAL_REGISTRY"},
    {"domain":"workflow","canonical":"current/RESEARCH_OS_WORKFLOW_EXPERIENCE_CONTRACT.json","role":"EXPERIENCE_CONTRACT_OVER_EXISTING_ENGINE"},
    {"domain":"evidence","canonical":"tools/lifecycle_evidence.py","role":"CANONICAL_EVIDENCE_PLANE"},
    {"domain":"release","canonical":"current/RESEARCH_OS_UNIFIED_FINAL_GATE.yml","role":"SINGLE_RELEASE_AUTHORITY"}
  ],
  "component_lifecycle": ["PLANNED","IN_PROGRESS","BLOCKED","HOLD","UNKNOWN","ACTIVE","DEPRECATED","RETIRED"],
  "resolutions": ["FOUND","PARTIAL","GAP","UNKNOWN","DRIFT"],
  "risk_classes": ["LOW","MEDIUM","HIGH","CRITICAL"],
  "change_control": {
    "required_fields": ["change_id","target_components","affected_contracts","risk_class","blast_radius","required_gates"],
    "hard_stop": [
      "authority_escalation",
      "duplicate_authority",
      "dependency_cycle",
      "contract_drift",
      "navigation_drift",
      "unknown_done",
      "missing_evidence",
      "stale_evidence",
      "exact_sha_mismatch"
    ],
    "merge_rule": "Governance validation is evidence for review; FINAL_GATE remains the release authority."
  },
  "evidence_coverage": {
    "required_dimensions": ["identity","contract","dependency","implementation","test","evidence","provenance","gate"],
    "unknown_is_not_pass": true,
    "missing_is_not_pass": true,
    "stale_is_not_pass": true
  },
  "invariants": [
    "one_canonical_navigation_registry",
    "one_release_authority",
    "no_duplicate_runtime_or_queue_authority",
    "observation_is_not_authorization",
    "evidence_is_not_authority",
    "unknown_is_not_done",
    "exact_sha_identity",
    "cross_project_isolation",
    "conflict_stop_release_reconcile",
    "history_is_immutable"
  ]
}
