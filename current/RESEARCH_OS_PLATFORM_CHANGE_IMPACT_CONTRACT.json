{
  "contract_id": "research-os-platform-change-impact-v1",
  "version": 1,
  "status": "ACTIVE",
  "purpose": "Canonical change-impact contract for tracing platform changes across components, projects, workflows, evidence, and required gates without creating a second change-control authority.",
  "authority": {
    "descriptive_only": true,
    "may_execute": false,
    "may_authorize": false,
    "may_approve": false,
    "may_merge": false,
    "may_release": false,
    "release_authority": "FINAL_GATE"
  },
  "required_fields": ["change_id","target_components","affected_contracts","risk_class","blast_radius","required_gates","evidence_refs"],
  "blast_radius": ["LOCAL","COMPONENT","PROJECT","CROSS_PROJECT","PLATFORM"],
  "rules": [
    "impact_must_be_explicit",
    "unknown_impact_is_not_zero",
    "change_analysis_does_not_execute_changes",
    "change_analysis_does_not_approve_changes",
    "reuse_existing_platform_graph_and_governance",
    "final_gate_remains_single_release_authority"
  ],
  "integration": {
    "governance": "current/RESEARCH_OS_PLATFORM_GOVERNANCE_CONTRACT.json",
    "engine": "tools/platform_change_impact.py",
    "evidence": "existing canonical evidence plane",
    "release": "current/RESEARCH_OS_UNIFIED_FINAL_GATE.yml"
  }
}
