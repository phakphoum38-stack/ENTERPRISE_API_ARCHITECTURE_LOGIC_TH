{
  "schema": "research-os-failure-knowledge/v1",
  "promotion_pipeline": [
    "FAILURE",
    "IMMUTABLE_FAILURE_EVIDENCE",
    "ROOT_CAUSE",
    "SOURCE_CORRECTION",
    "REGRESSION_TEST",
    "PROVENANCE",
    "FORENSIC_VERIFICATION",
    "LESSON",
    "PREVENTION_RULE"
  ],
  "record_fields": [
    "failure_id",
    "first_seen_sha",
    "failure_evidence_refs",
    "classification",
    "root_cause",
    "fix_refs",
    "regression_refs",
    "forensic_refs",
    "lesson",
    "prevention_rule",
    "status"
  ],
  "rules": {
    "preserve_before_repair": true,
    "preexisting_and_introduced_must_be_distinguished": true,
    "root_cause_requires_evidence": true,
    "knowledge_promotion_is_required_for_material_failures": true,
    "historical_failure_records_are_immutable": true
  }
}
