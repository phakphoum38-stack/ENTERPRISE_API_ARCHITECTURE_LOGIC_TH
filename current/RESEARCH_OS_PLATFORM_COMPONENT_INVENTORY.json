  "rules": [
    "metadata_only",
    "canonical_sources_remain_authoritative",
    "unknown_is_not_done",
    "missing_evidence_is_not_pass",
    "final_gate_is_single_release_authority",
    "nvme_is_storage_backed_memory_not_dram",
    "unknown_hardware_capability_is_not_available",
    "unknown_runner_capability_is_not_available",
    "cloud_drive_is_distribution_not_runtime",
    "verified_package_required_before_install"
  ],
  "schema_version": 1,
  "component_model_version": 1,
  "count_is_informational": true,
  "required_component_selection": "component.required == true",
  "lifecycle_model": [
    "PROPOSED",
    "EXPERIMENTAL",
    "ACTIVE",
    "DEPRECATED",
    "RETIRED"
  ],
  "classes": [
    "CORE",
    "PLATFORM",
    "ASSURANCE",
    "EXPERIENCE",
    "EXTENSION"
  ],
  "registry_semantics": {
    "single_source_of_truth": true,
    "registry_is_descriptive_metadata": true,
    "count_is_not_a_contract": true,
    "required_components_are_explicit": true,
    "optional_components_may_be_added_without_validator_changes": true,
    "dependency_references_must_resolve": true,
    "authority_is_explicit": true
  }
}
