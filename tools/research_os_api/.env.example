# Active provider: mock | openai-compatible | local | anthropic | gemini
RESEARCH_OS_PROVIDER=mock

# OpenAI-compatible or local endpoint
RESEARCH_OS_OPENAI_ENDPOINT=http://localhost:11434/v1/chat/completions
RESEARCH_OS_OPENAI_MODEL=local-model
