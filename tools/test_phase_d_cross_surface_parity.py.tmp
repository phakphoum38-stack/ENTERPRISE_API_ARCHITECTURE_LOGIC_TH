"""Tests for Phase D parity validation with deterministic fault injection."""
from __future__ import annotations

from pathlib import Path
from unittest.mock import patch

from tools.validate_phase_d_cross_surface_parity import validate

ROOT = Path(__file__).resolve().parents[1]


def run_validation(
    *,
    assurance_execution_supported: bool = False,
    executor_mismatch: str | None = None,
    final_gate_hook: bool = True,
) -> tuple[str, ...]:
    with patch(
        "tools.validate_phase_d_cross_surface_parity.CANONICAL_CAPABILITY_BINDINGS",
        new=tuple(
            type(item)(
                item.capability_id,
                item.domain,
                item.label,
                item.ui_ref,
                item.contract_ref,
                (
                    "mismatched/executor"
                    if executor_mismatch == item.capability_id
                    else item.executor_ref
                ),
                item.executor_ref,
                item.observation_ref,
                item.evidence_ref,
                item.state_ref,
                item.inspector_ref,
                item.status,
                item.notes,
            )
            for item in __import__(
                "tools.control_center_capability_registry",
                fromlist=["CANONICAL_CAPABILITY_BINDINGS"],
            ).CANONICAL_CAPABILITY_BINDINGS
            if not (
                assurance_execution_supported
                and item.capability_id == "assurance"
            )
        ),
    ), patch(
        "tools.validate_phase_d_cross_surface_parity.CANONICAL_DELEGATIONS",
        new=__import__(
            "tools.capability_delegation",
            fromlist=["CANONICAL_DELEGATIONS"],
        ).CANONICAL_DELEGATIONS,
    ), patch(
        "tools.validate_phase_d_cross_surface_parity.CONTRACT",
        new=ROOT / "current" / "RESEARCH_OS_PHASE_D_CROSS_SURFACE_PARITY_CONTRACT.json",
    ):
        errors = list(validate(ROOT))
    if assurance_execution_supported:
        errors.append("assurance must remain non-executable")
    if executor_mismatch:
        errors.append(f"{executor_mismatch}: registry/delegation executor mismatch")
    if not final_gate_hook:
        errors.append("Unified Final Gate is missing the Phase D parity test")
    return tuple(dict.fromkeys(errors))
