{
  "name": "research-os/laravel-platform",
  "description": "Research OS Laravel Platform integration component",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "ResearchOS\\Platform\\": "src/Platform/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "php artisan about",
    "contract": "php artisan research-os:contract"
  }
}
