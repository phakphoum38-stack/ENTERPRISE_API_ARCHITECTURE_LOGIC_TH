"""P1-43 federation evidence query projection.
Pure projection over existing federation evidence and canonical identity.
"""
from __future__ import annotations
from dataclasses import dataclass
import hashlib,json
from .canonical_identity_federation import CanonicalIdentity,CanonicalIdentityError
from .p1_04_execution_evidence_binding import ExecutionEvidenceBinding
class P143Error(CanonicalIdentityError): pass
@dataclass(frozen=True)
class P143Projection:
    identity: CanonicalIdentity
    evidence_ids: tuple[str,...]
    binding_hashes: tuple[str,...]
    fingerprint: str
    @property
    def projection_hash(self)->str:
        m={"stage":43,"identity":self.identity.fingerprint(),"evidence_ids":self.evidence_ids,"binding_hashes":self.binding_hashes,"fingerprint":self.fingerprint}
        return hashlib.sha256(json.dumps(m,sort_keys=True,separators=(",",":")).encode()).hexdigest()
def project_p1_43(*,identity:CanonicalIdentity,bindings:list[ExecutionEvidenceBinding],fingerprint:str)->P143Projection:
    if len(fingerprint)!=64: raise P143Error("fingerprint must be SHA-256")
    if not bindings: raise P143Error("evidence binding is required")
    for x in bindings:
        if x.identity!=identity: raise P143Error("evidence crosses canonical lineage")
        if len(x.binding_hash)!=64: raise P143Error("binding hash must be SHA-256")
        if not x.evidence_id.strip(): raise P143Error("evidence_id is required")
    return P143Projection(identity,tuple(dict.fromkeys(x.evidence_id for x in bindings)),tuple(dict.fromkeys(x.binding_hash for x in bindings)),fingerprint)
def assert_p1_43_lineage(p:P143Projection,identity:CanonicalIdentity)->None:
    if p.identity!=identity: raise P143Error("projection lineage mismatch")
